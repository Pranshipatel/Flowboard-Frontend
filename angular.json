{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "flowboard-frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "40kB",
                  "maximumError": "80kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "flowboard-frontend:build:production"
            },
            "development": {
              "buildTarget": "flowboard-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "karma",
            "browsers": [
              "ChromeHeadless"
            ],
            "runnerConfig": "karma.conf.js",
            "coverage": false,
            "coverageExclude": [
              "src/**/*.spec.ts",
              "src/**/*.test.ts",
              "src/main.ts",
              "src/app/app.config.ts",
              "src/app/app.routes.ts",
              "src/environments/**",
              "src/app/core/services/**",
              "src/app/core/guards/**",
              "src/app/core/interceptors/**",
              "src/app/pages/board/board-view/**",
              "src/app/pages/board/card-detail/**",
              "src/app/pages/board/archive-manager/**",
              "src/app/pages/workspace/workspace-detail/**",
              "src/app/pages/dashboard/dashboard/**",
              "src/app/pages/dashboard/search/**",
              "src/app/pages/profile/**",
              "src/app/shared/components/**"
            ],
            "coverageReporters": [
              "html",
              [
                "lcovonly",
                {
                  "file": "lcov.info"
                }
              ],
              "text-summary"
            ]
          }
        }
      }
    }
  }
}
